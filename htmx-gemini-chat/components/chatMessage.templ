templ GeminiMessage(model models.ChatConversation) {
	<div
		class="relative w-full hidden items-start gap-2 p-1"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" class="shrink-0">
			<path d="M20 10.0196C14.6358 10.3431 10.3431 14.6358 10.0196 20H9.98042C9.65687 14.6358 5.36425 10.3431 0 10.0196V9.98043C5.36425 9.65688 9.65687 5.36424 9.98042 0H10.0196C10.3431 5.36424 14.6358 9.65688 20 9.98043V10.0196Z" fill="url(#paint0_radial_809_11874)"></path>
			<defs>
				<radialGradient id="paint0_radial_809_11874" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(-6.13727 9.97493) scale(21.6266 172.607)">
					<stop offset="0.385135" stop-color="#9E72BA"></stop>
					<stop offset="0.734299" stop-color="#D65C67"></stop>
					<stop offset="0.931035" stop-color="#D6635C"></stop>
				</radialGradient>
			</defs>
		</svg>
		<div class="flex flex-col gap-1 w-full">
			if model.FileData!="" {
				<img
					class="h-full w-full"
					src={ model.FileData }
				/>
			}
			<div class="flex-1 max-w-full" x-data={ "{md:`" + formatMessageForAlpine(model.Message) + "`}" }>
				<zero-md>
					<script type="text/markdown" x-html="md" id={ "message_" + strconv.Itoa(model.Id) }>			        
			   		 </script>
				</zero-md>
			</div>
		</div>
		<button
			class="appearance-none outline-none absolute shadow -right-1 -bottom-1  p-1 text-red-600 dark:text-red-300 rounded-full cursor-pointer transition duration-300 focus:ring-1 focus:ring-red-600 dark:focus:ring-red-300 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-80"
			hx-delete={ `/chats/delete/` + strconv.Itoa(model.Id) }
			hx-swap="outerHTML transition:true"
			hx-target="closest div"
			id={ "btnDeleteMessage_" + strconv.Itoa(model.Id) }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
}

templ GeminiMessageTemplate(model models.ChatTemplate) {
	<div
		class="relative w-full flex items-start gap-2 p-1"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" class="shrink-0">
			<path d="M20 10.0196C14.6358 10.3431 10.3431 14.6358 10.0196 20H9.98042C9.65687 14.6358 5.36425 10.3431 0 10.0196V9.98043C5.36425 9.65688 9.65687 5.36424 9.98042 0H10.0196C10.3431 5.36424 14.6358 9.65688 20 9.98043V10.0196Z" fill="url(#paint0_radial_809_11874)"></path>
			<defs>
				<radialGradient id="paint0_radial_809_11874" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(-6.13727 9.97493) scale(21.6266 172.607)">
					<stop offset="0.385135" stop-color="#9E72BA"></stop>
					<stop offset="0.734299" stop-color="#D65C67"></stop>
					<stop offset="0.931035" stop-color="#D6635C"></stop>
				</radialGradient>
			</defs>
		</svg>
		<div class="flex flex-col gap-1 w-full">
			<div class="flex-1 max-w-full">
				<div class="flex items-center gap-1 flex-1 mt-2 ml-2" id="promptProcessingIndicator">
					<span class="h-1.5 w-1.5 bg-slate-600 dark:bg-slate-100 rounded-full animate-loader-one"></span>
					<span class="h-1.5 w-1.5 bg-slate-600 dark:bg-slate-100 rounded-full animate-loader-two"></span>
					<span class="h-1.5 w-1.5 bg-slate-600 dark:bg-slate-100 rounded-full animate-loader-three"></span>
				</div>
				<zero-md>
					<script type="text/markdown" id={ "message_" + strconv.Itoa(model.ConversationId) }>					
                	</script>
				</zero-md>
			</div>
		</div>
		<button
			class="appearance-none outline-none absolute shadow -right-1 -bottom-1  p-1 text-red-600 dark:text-red-300 rounded-full cursor-pointer transition duration-300 focus:ring-1 focus:ring-red-600 dark:focus:ring-red-300 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-80"
			hx-delete={ `/chats/delete/` + strconv.Itoa(model.ConversationId) }
			hx-swap="outerHTML transition:true"
			hx-target="closest div"
			id={ "btnDeleteMessage_" + strconv.Itoa(model.ConversationId) }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
}
