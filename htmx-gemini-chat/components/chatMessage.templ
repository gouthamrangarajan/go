package components

import "strconv"
import "strings"
import "htmx-gemini-chat/models"

func formatMessageForAlpine(message string) string {
	ret := strings.ReplaceAll(message, `\`, `\\`)
	ret = strings.ReplaceAll(ret, "${", `\${`)
	ret = strings.ReplaceAll(ret, "`", "\\`")
	return ret
}

templ UserMessage(model models.ChatConversation) {
	<div
		class={ "relative w-full hidden items-start gap-2 p-1 " }
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 shrink-0">
			<path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd"></path>
		</svg>
		<div class="flex flex-col gap-1 w-full">
			if model.FileData!="" {
				if strings.HasSuffix(strings.ToLower(model.FileName),".pdf") {
					<p class="font-semibold flex gap-2 truncate text-lime-700 dark:text-lime-500">
						{ model.FileName }
					</p>
				} else {
					<img
						class="h-full w-full"
						src={ model.FileData }
					/>
				}
			}
			<div class="flex-1 max-w-full" x-data={ "{md:`" + formatMessageForAlpine(model.Message) + "`}" }>
				<zero-md>
					<script type="text/markdown" x-html="md" id={ "message_" + strconv.Itoa(model.Id) }>			        
			    	</script>
				</zero-md>
			</div>
		</div>
		<button
			class="appearance-none outline-none absolute shadow -right-1 -bottom-1  p-1 text-red-600 dark:text-red-300 rounded-full cursor-pointer transition duration-300 focus:ring-1 focus:ring-red-600 dark:focus:ring-red-300 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-80"
			hx-delete={ `/chats/delete/` + strconv.Itoa(model.Id) }
			hx-swap="outerHTML transition:true"
			hx-target="closest div"
			id={ "btnDeleteMessage_" + strconv.Itoa(model.Id) }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
}

