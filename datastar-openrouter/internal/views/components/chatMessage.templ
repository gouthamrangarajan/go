package components

import (
	"datastar-openrouter/internal/models"
	"strconv"
	"strings"
)

templ ChatMessage(message models.ChatConversation, stream bool) {
	<div
		id={ "message-" + strconv.Itoa(message.Id) }
		class="py-1 px-3 flex gap-4 items-start relative max-w-11/12 md:max-w-full"
	>
		@ChatMessageRoleLogo(message.Id, message.Role)
		<div class="flex w-full flex-col" id={ "markdownToHtmlAndFileNameContainer_" + strconv.Itoa(message.Id) }>
			if !stream {
				<div
					id={ "markdownToHtml_" + strconv.Itoa(message.Id) }
					class="min-h-screen"
				></div>
			} else {
				<div
					id={ "markdownToHtml_" + strconv.Itoa(message.Id) }
				></div>
			}
			@ChatMessageFileData(message, stream)
			if message.Role=="assistant" && stream {
				<span
					class="animate-pulse opacity-80 text-sm"
					id="thinkingMesssage"
				>thinking...</span>
			}
		</div>
		@ChatMessageModelIdDisplay(message)
		if message.Role == "user" {
			<button
				aria-label="retry"
				class="appearance-none outline-none absolute cursor-pointer -bottom-3 right-4 p-1 rounded-full transition duration-300 bg-gray-100 dark:bg-slate-700 hover:bg-gray-200 dark:hover:bg-slate-800 focus:bg-gray-200 dark:focus:bg-slate-800 focus:ring-1 focus:ring-dark dark:focus:ring-light  disabled:cursor-not-allowed disabled:opacity-80"
				data-on:click={ `$messageIdToRetry=` + strconv.Itoa(message.Id) + `; @post("/retry",{openWhenHidden: true});` }
				data-indicator="_retrying"
				data-attr:disabled="$_processingViaButton || $_processingViaInput || $_retrying"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-5"
				>
					<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path>
				</svg>
			</button>
		}
	</div>
}

templ ChatMessageRoleLogo(id int, role string) {
	if role=="assistant" {
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="size-10 shrink-0 -ml-2 -z-10"
    		 id={ "logoSvg_" + strconv.Itoa(id) }>
			<defs>
				<radialGradient id="coreGrad" cx="50%" cy="50%" r="50%">
					<stop offset="0%"  stop-color="#ffffff"/>
					<stop offset="40%" stop-color="#818cf8"/>
					<stop offset="100%" stop-color="#4f46e5"/>
				</radialGradient>
				<linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%"   stop-color="#0f172a"/>
					<stop offset="100%" stop-color="#1e293b"/>
				</linearGradient>
			</defs>

			<rect width="100" height="100" rx="22" fill="url(#bgGrad)"/>

			<g stroke-width="3" stroke-linecap="round" fill="none" opacity="0.7">
				<line x1="25" y1="25" x2="50" y2="50" stroke="#34d399"/>
				<line x1="75" y1="25" x2="50" y2="50" stroke="#60a5fa"/>
				<line x1="25" y1="75" x2="50" y2="50" stroke="#fbbf24"/>
				<line x1="75" y1="75" x2="50" y2="50" stroke="#f472b6"/>
			</g>

			<circle cx="25" cy="25" r="7" fill="#34d399"/>
			<circle cx="75" cy="25" r="7" fill="#60a5fa"/>
			<circle cx="25" cy="75" r="7" fill="#fbbf24"/>
			<circle cx="75" cy="75" r="7" fill="#f472b6"/>

			<circle cx="50" cy="50" r="18" fill="url(#coreGrad)"/>
			<circle cx="50" cy="50" r="7"  fill="#ffffff" opacity="0.9"/>
		</svg>
	} else {
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="currentColor"
			id={ "logoSvg_" + strconv.Itoa(id) }
			class="size-6 shrink-0 -z-10"
		>
			<path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd"></path>
		</svg>
	}
}

templ ChatMessageFileData(message models.ChatConversation, stream bool) {
	{{ messageIdStr := strconv.Itoa(message.Id) }}
	if message.FileName!="" {
		switch  {
			case  strings.HasSuffix(strings.ToLower(message.FileName),".pdf"):
				<p
					class="font-semibold flex gap-1 cursor-pointer relative"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
						<path fill-rule="evenodd" d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd"></path>
					</svg>
					<span>{ message.FileName }</span>
				</p>
			case message.FileData!="":
				<img
					src={ message.FileData }
					id={ "image_" + messageIdStr }
					alt={ ` image for ` + messageIdStr }
					class="w-full h-full"
				/>
			case message.FileData=="" && stream:
				<img
					style="display:none"
					id={ "image_" + messageIdStr }
					alt={ ` image for ` + messageIdStr }
					class="w-full h-full"
				/>
			case  message.FileData=="" && !stream:
				<p
					class="font-semibold flex gap-1 relative"
					data-signals={ `{showImage_` +messageIdStr + `:false,
								imageFetched_` + messageIdStr + `:false }` }
					data-on:mouseenter={ `if(!$imageFetched_` + messageIdStr + `){
										$messageIdToFetchImage=` + messageIdStr + `;@post('/image');}
									 else{$showImage_` + messageIdStr + `=true;}` }
					data-on:mouseleave__viewtransition={ `$showImage_` + messageIdStr + `=false` }
					data-indicator={ `_fetchingImage_` + messageIdStr }
					data-class={ `{'animate-pulse cursor-wait':$_fetchingImage_` + messageIdStr + `,'cursor-pointer':!$_fetchingImage_` + messageIdStr + `}` }
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
						<path fill-rule="evenodd" d="M15.621 4.379a3 3 0 0 0-4.242 0l-7 7a3 3 0 0 0 4.241 4.243h.001l.497-.5a.75.75 0 0 1 1.064 1.057l-.498.501-.002.002a4.5 4.5 0 0 1-6.364-6.364l7-7a4.5 4.5 0 0 1 6.368 6.36l-3.455 3.553A2.625 2.625 0 1 1 9.52 9.52l3.45-3.451a.75.75 0 1 1 1.061 1.06l-3.45 3.451a1.125 1.125 0 0 0 1.587 1.595l3.454-3.553a3 3 0 0 0 0-4.242Z" clip-rule="evenodd"></path>
					</svg>
					<span>{ message.FileName }</span>
					<img
						style="display:none;"
						id={ "image_" + messageIdStr }
					/>
				</p>
		}
	}
}

templ ChatMessageImageDisplayOnHover(message models.ChatConversation) {
	{{ messageIdStr := strconv.Itoa(message.Id) }}
	<img
		class="w-auto h-auto max-w-screen max-h-screen absolute top-0 left-0 animate-image z-10 rounded shadow origin-top"
		src={ message.FileData }
		id={ "image_" + messageIdStr }
		alt={ ` image for ` + messageIdStr }
		data-show={ `$showImage_` + messageIdStr }
	/>
}

templ ChatMessageModelIdDisplay(message models.ChatConversation) {
	if message.ModelId!="" {
		<span
			class="absolute -bottom-4 right-4 text-xs italic p-1 rounded-full bg-dark dark:bg-light  text-light dark:text-dark"
			id={ "model_" + strconv.Itoa(message.Id) }
		>
			{ message.ModelId }
		</span>
	} else {
		<span
			class="absolute -bottom-4 right-4"
			id={ "model_" + strconv.Itoa(message.Id) }
		></span>
	}
}
