
package components

import (
	"datastar-openrouter/components/shared"
	"datastar-openrouter/models"
	"strconv"
)

templ menu(sessions []models.ChatSession, searchTerm string) {
	<div
		class="absolute top-0 left-0 w-full h-full bg-white/40 z-10"
		data-show="$showMenu"
		data-signals="{_menuFocusAbortController:new AbortController()}"
		data-on:click__viewtransition="$showMenu=false"
	>
		<div
			class="flex gap-2 items-start h-full w-11/12 md:w-9/12 lg:w-5/12 xl:w-4/12"
			id="menuContainer"
			data-effect="$showDeleteModal?$_menuFocusAbortController.abort():$showMenu?setTimeout(()=>$_menuFocusAbortController=focusTrap('#menuContainer')):$_menuFocusAbortController.abort()"
		>
			<div
				class="flex flex-col items-center flex-1 border-r border-gray-600 dark:border-gray-300  h-full overflow-y-auto bg-light dark:bg-dark scroll-smooth scrollbar-thin scrollbar-thumb-dark dark:scrollbar-thumb-light scrollbar-track-gray-300 dark:scrollbar-track-slate-800"
				data-on:click="evt.stopPropagation()"
			>
				<button
					class="appearance-none outline-none transition duration-300 mt-10 py-2 px-4 rounded cursor-pointer font-semibold w-10/12 bg-dark dark:bg-light text-light dark:text-dark  focus:ring-2 focus:ring-dark dark:focus:ring-light  focus:ring-offset-2 focus:ring-offset-light dark:focus:ring-offset-dark disabled:cursor-not-allowed disabled:opacity-80"
					data-class="{'animate-pulse':$_creatingNewSession}"
					data-on:click={ `$pageLoading=true;@post('/new',{openWhenHidden:true});` }
					data-indicator="_creatingNewSession"
					data-attr:disabled="$_creatingNewSession"
				>
					New Chat
				</button>
				<div class="mt-5 w-full py-2 px-4 flex items-center gap-1 transition duration-300 border-t border-b border-dark/50 dark:border-light/50  focus-within:border-dark dark:focus-within:border-light ">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
						<path fill-rule="evenodd" d="M10.5 3.75a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5ZM2.25 10.5a8.25 8.25 0 1 1 14.59 5.28l4.69 4.69a.75.75 0 1 1-1.06 1.06l-4.69-4.69A8.25 8.25 0 0 1 2.25 10.5Z" clip-rule="evenodd"></path>
					</svg>
					<input
						type="text"
						class="appearance-none outline-none flex-1 placeholder:text-slate-600 dark:placeholder:text-slate-400 "
						data-bind="searchMenu"
						placeholder="Search Chats..."
						data-indicator="_searching"
						data-on:keyup__debounce.500ms__viewtransition="@post('/sessions/search',{openWhenHidden:true})"
					/>
					<button
						class="appearance-none outline-none cursor-pointer transition duration-300 rounded-full p-1 font-semibold text-red-600 dark:text-red-300 focus:ring-1 focus:ring-red-600 dark:focus:ring-red-300 hover:opacity-90"
						aria-label="Clear Search"
						style="view-transition-name:search-action-icon"
						data-show="!$_searching && $searchMenu!=''"
						data-on:click__viewtransition="$searchMenu='';@post('/sessions/search',{openWhenHidden:true})"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
							<path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"></path>
						</svg>
					</button>
					<div
						data-show="$_searching"
						class="appearance-none outline-none cursor-pointer transition duration-300 rounded-full p-1 border-dark dark:border-light"
						data-class="{' animate-border':$_searching}"
						style="view-transition-name:search-action-icon"
					>
						@shared.Loader("")
					</div>
				</div>
				@MenuUl(sessions, searchTerm)
			</div>
			<button
				class="appearance-none outline-none cursor-pointer mt-2 transition duration-300 rounded p-1 hover:opacity-90 bg-dark  text-white focus:ring-2 focus:ring-dark focus:ring-offset-2 focus:ring-offset-white disabled:cursor-not-allowed disabled:opacity-80"
				style="view-transition-name:menu-button"
				aria-label="Close Menu"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="currentColor"
					class="size-6"
					style="view-transition-name:menu-button-icon"
				>
					<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
				</svg>
			</button>
		</div>
	</div>
	<button
		class="appearance-none outline-none cursor-pointer absolute top-3 left-2 transition duration-300 rounded p-1 hover:opacity-80 bg-dark dark:bg-light  text-light dark:text-dark  focus:ring-2 focus:ring-dark dark:focus:ring-light  focus:ring-offset-2 focus:ring-offset-light dark:focus:ring-offset-dark  disabled:cursor-not-allowed disabled:opacity-80"
		data-on:click__viewtransition="$showMenu=true"
		style="view-transition-name:menu-button"
		data-show="!$showMenu"
		aria-label="Open Menu"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="currentColor"
			class="size-6"
			style="view-transition-name:menu-button-icon"
		>
			<path fill-rule="evenodd" d="M3 6.75A.75.75 0 0 1 3.75 6h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 6.75ZM3 12a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 12Zm0 5.25a.75.75 0 0 1 .75-.75h16.5a.75.75 0 0 1 0 1.5H3.75a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd"></path>
		</svg>
	</button>
}

templ MenuUl(sessions []models.ChatSession, searchTerm string) {
	<ul class="flex flex-col mt-5 w-full" id="menu">
		for _,session := range sessions {
			@MenuItem(session, searchTerm)
		}
	</ul>
}

templ MenuItem(session models.ChatSession, searchTerm string) {
	{{ href := "/" + strconv.Itoa(session.Id) }}
	{{
		if searchTerm != "" {
			href += "?search_menu=" + searchTerm
		}
	}}
	<li
		class="w-full flex gap-1 items-center pr-3 hover:bg-gray-200 dark:hover:bg-slate-800 focus-within:bg-gray-200 dark:focus-within:bg-slate-800"
		data-class={ "{'underline underline-offset-6':$sessionId==" + strconv.Itoa(session.Id) + "}" }
		id={ "menuItem_" + strconv.Itoa(session.Id) }
		style={ "view-transition-name:menu-item-" + strconv.Itoa(session.Id) }
	>
		<a
			href={ href }
			data-on:click__prevent={ `	
				$pageLoading=true;
				$sessionId=` + strconv.Itoa(session.Id) + `;				
				@get('` + href + `');
				` }
			class="appearance-none outline-none truncate flex-1 py-2 px-4 transition duration-300 cursor-pointer"
		>
			{ session.Title }
		</a>
		<button
			class="appearance-none outline-none cursor-pointer transition duration-300 rounded-full p-1 font-semibold text-gray-600 dark:text-gray-500 focus:ring-2 focus:ring-red-600 dark:focus:ring-red-300  focus:text-red-600 dark:focus:text-red-300 hover:text-red-600 dark:hover:text-red-300 "
			data-on:click__viewtransition={ `
                evt.stopPropagation();
                $sessionIdToDelete=` + strconv.Itoa(session.Id) + `;                
                $showDeleteModal=true;
            ` }
			aria-label="Delete Chat Session"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</li>
}
