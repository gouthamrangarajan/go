package components

import (
	"datastar-stock/components/shared"
	"datastar-stock/models"
	"strconv"
)

templ PopularsConfigure() {
	<div
		id="overlay"
		class="bg-black/30 absolute top-0 left-0 w-full h-full flex items-center justify-center"
		style="view-transition-name:overlay"
		data-signals="{_abortController:new AbortController()}"
		data-on-load="executeModalScript($_abortController.signal)"
	>
		<dialog
			open
			class="py-2 px-4 animate-modal rounded flex flex-col mx-auto w-11/12 md:py-4 md:px-4 lg:w-10/12 xl:w-9/12"
			style="view-transition-name:modal"
			id="modal"
			data-signals-allow-populars-add="true"
			data-signals-allow-populars-remove="true"
		>
			<div class="flex justify-between items-start w-full">
				<div class="flex flex-col w-full gap-1">
					<div class="flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-yellow-600 mt-0.25">
							<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"></path>
						</svg>
						<h1 class="text-xl text-primary underline underline-offset-6">Configure Your Populars</h1>
					</div>
					<p class="text-slate-600 text-sm">
						Select up to 5 stocks from your watchlist
					</p>
				</div>
				<button
					class="appearance-none outline-none p-1 flex cursor-pointer text-red-600 transition duration-300 rounded-full focus:ring-2 focus:ring-red-600 disabled:cursor-not-allowed disabled:opacity-80"
					data-on-click="$_abortController.abort();@post('/home/populars/configure/close')"
					aria-label="close"
					data-indicator-closing-configure-populars
					data-attr-disabled="$closingConfigurePopulars"
				>
					<svg
						data-show="!$closingConfigurePopulars"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="currentColor"
						class="size-5"
					>
						<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
					</svg>
					@shared.Spinner(models.Spinner{DataShowSignal: "$closingConfigurePopulars", Class: "border-red-600"})
				</button>
			</div>
			<div class="mt-3 flex flex-col gap-2 w-full pb-10 lg:flex-row lg:items-start lg:justify-between">
				<div class="flex flex-col gap-2 w-full">
					<div class="w-full flex items-center justify-between">
						<h2 class="text-lg text-menu font-semibold">Your Populars</h2>
						<span id="availablePopularsCount"></span>
					</div>
					<div id="popularsConfigure" class="flex flex-col gap-2 h-40 overflow-x-hidden overflow-y-auto scrollbar-thin scroll-smooth scrollbar-track-transparent scrollbar-thumb-[#8A2BE2] lg:h-80 "></div>
				</div>
				<div class="flex flex-col gap-2 w-full">
					<h2 class="text-lg text-menu font-semibold">Recent Watchlist</h2>
					<div id="recentPopularsConfigure" class="flex flex-col gap-2 pb-4 h-40 overflow-x-hidden overflow-y-auto scrollbar-thin scroll-smooth scrollbar-track-transparent scrollbar-thumb-[#8A2BE2] lg:h-80"></div>
				</div>
			</div>
		</dialog>
	</div>
}

templ PopularsConfigureCards(items []models.TickerCard, section string) {
	for _, item := range items {
		@PopularsConfigureCard(item, section)
	}
}

templ PopularsConfigureCard(item models.TickerCard, section string) {
	if section == "recent" {
		<form
			data-on-submit="@post('/home/populars/add',{contentType:'form'})"
			data-indicator={ "addingPopulars_" + shared.ReplaceSpecialCharsInTicker(item.Ticker) }
			class="w-full p-2"
			id={ "popularsConfigure_" + shared.ReplaceSpecialCharsInTicker(item.Ticker) }
		>
			<input type="hidden" name="ticker" value={ item.Ticker }/>
			<button
				type="submit"
				class="appearance-none outline-none py-2 px-4 w-full flex justify-between gap-2 items-center text-left rounded shadow cursor-pointer transition duration-300 hover:shadow-lg hover:shadow-secondary/30 disabled:opacity-50 focus:ring-2 focus:ring-secondary "
				style={ "view-transition-name:populars-configure-" + item.Ticker }
				data-attr-disabled={ "$addingPopulars_" + shared.ReplaceSpecialCharsInTicker(item.Ticker) + "|| !$allowPopularsAdd" }
			>
				<div class="flex flex-col gap-1 ">
					<p class="text-lg text-slate-700">{ item.Ticker }</p>
					<p class="text-sm text-slate-500">{ item.Name }</p>
				</div>
				@shared.Spinner(models.Spinner{DataShowSignal: "$addingPopulars_" + shared.ReplaceSpecialCharsInTicker(item.Ticker), Class: "border-secondary"})
			</button>
		</form>
	} else {
		<form
			data-on-submit="@post('/home/populars/remove',{contentType:'form'})"
			data-indicator={ "removingPopulars_" + shared.ReplaceSpecialCharsInTicker(item.Ticker) }
			class="appearance-none outline-none py-2 px-4 w-full flex justify-between gap-2 items-center text-left rounded shadow cursor-pointer transition duration-300 hover:shadow-lg hover:shadow-secondary/30"
			id={ "popularsConfigure_" + shared.ReplaceSpecialCharsInTicker(item.Ticker) }
		>
			<input type="hidden" name="ticker" value={ item.Ticker }/>
			<div class="flex flex-col gap-1 ">
				<p class="text-lg text-slate-700">{ item.Ticker }</p>
				<p class="text-sm text-slate-500">{ item.Name }</p>
			</div>
			<button
				class="appearance-none outline-none p-1 flex cursor-pointer text-red-600 transition duration-300 rounded-full focus:ring-2 focus:ring-red-600 disabled:cursor-not-allowed disabled:opacity-80"
				type="submit"
				aria-label="remove"
				data-attr-disabled={ "$removingPopulars_" + shared.ReplaceSpecialCharsInTicker(item.Ticker) + "|| !$allowPopularsRemove" }
			>
				<svg
					data-show={ "!$removingPopulars_" + shared.ReplaceSpecialCharsInTicker(item.Ticker) }
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="currentColor"
					class="size-5"
				>
					<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
				</svg>
				@shared.Spinner(models.Spinner{DataShowSignal: "$removingPopulars_" + shared.ReplaceSpecialCharsInTicker(item.Ticker), Class: "border-red-600"})
			</button>
		</form>
	}
}

templ AvailablePopularsCount(count int) {
	<span class="rounded-full py-0.5 px-2.5 bg-slate-200 text-slate-800 text-sm font-semibold" id="availablePopularsCount">
		{ strconv.Itoa(count) }/5
	</span>
}
