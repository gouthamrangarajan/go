package components

import "datastar-stock/components/shared"

templ Populars(tickers []string) {
	@home() {
		<div class="py-2 px-4 grid grid-cols-1 gap-2 mt-2 lg:gap-4 lg:grid-cols-2">
			@shared.Cards(tickers)
		</div>
	}
}

templ PopularsError() {
	@home() {
		<div class="py-2 px-4 grid grid-cols-1 gap-2 mt-2 lg:gap-4 lg:grid-cols-2">
			@shared.CardError()
		</div>
	}
}
