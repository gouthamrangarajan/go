package components

import "datastar-stock/components/shared"

templ layout() {
	<!DOCTYPE html>
	<html lang="en" class="w-full h-full">
		<head>
			<title>RG Stock</title>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" href="/assets/imgs/favicon.ico" type="image/x-icon"/>
			<link rel="stylesheet" href="/assets/css/styles.css"/>
			<link rel="stylesheet" href="/assets/css/open-props.min.css"/>
			<script src="/assets/js/data-star.min.js" type="module"></script>
			<script src="/assets/js/echarts.min.js"></script>
		</head>
		<body class="relative w-full h-full bg-slate-100">
			<main class="w-full h-full flex flex-col gap-2 overflow-y-auto scrollbar-thin scroll-smooth scrollbar-track-violet-200 scrollbar-thumb-[#8A2BE2]">
				{ children... }
			</main>
			@shared.ChartScript()
			@shared.ModalScript()
		</body>
	</html>
}
