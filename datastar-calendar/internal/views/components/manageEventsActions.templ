package components

import "strconv"

templ ToggleEventStatusButton(id string, isActive bool) {
	<button
		id={ "toggle-status-btn-" + id }
		class="appearance-none outline-none relative h-6 w-12 rounded-full transition duration-300 
				cursor-pointer focus:ring-2 focus:ring-orange-600 focus:ring-offset-2
				 focus:ring-offset-orange-50 disabled:cursor-not-allowed disabled:animate-pulse"
		aria-label="Toggle Status"
		data-class={ `{'bg-orange-600 ':` + strconv.FormatBool(isActive) + `==true,
                        'bg-gray-200 ':`+strconv.FormatBool(isActive) + `==false}` }
		data-on:click={ `$eventId='`+id+`';$isActive=`+strconv.FormatBool(!isActive)+`;
                        @post('/events/`+id+`/status',{openWhenHidden:true})` }
		data-indicator={ "_updatingStatus-" + id }
		data-attr:disabled={ "$_updatingStatus-" + id }
	>
		<span
			class="absolute top-1 left-1 h-4 w-4 rounded-full bg-white"
			data-class={ `{'tranform translate-x-6':` + strconv.FormatBool(isActive) + `==true}` }
			style={ "view-transition-name:toggle-status-btn-span-" + id }
		></span>
	</button>
}

templ FilterAllEventsButton(count int) {
	<button
		class="appearance-none outline-none rounded-full cursor-pointer py-1 px-2 transition duration-300
				flex items-center gap-2 focus:ring-2 focus:ring-teal-700 focus:ring-offset-2
				focus:ring-offset-teal-50 disabled:cursor-not-allowed disabled:animate-pulse"
		data-class={ `{'bg-teal-700 text-white':$managePageFilter=='all',
						'border border-slate-300':$managePageFilter!='all'}` }
		aria-label="Filter All Events"
		id="btnAllEvents"
		style="view-transition-name:btn-all-events"
		data-on:click="$managePageNumber=1;$managePageFilter='all';@post('/manage/filter',{openWhenHidden:true})"
		data-indicator="_fetchingAllStatusRecord"
		data-attr:disabled={ `$_fetchingActiveStatusRecord || $_fetchingInactiveStatusRecord 
					|| $_fetchingAllStatusRecord` }
	>
		<span>All</span>
		<span
			class="py-1 px-2 text-sm rounded-full"
			data-class={ `{'bg-teal-600':$managePageFilter=='all',
							'bg-gray-200':$managePageFilter!='all'}` }
		>{ strconv.Itoa(count) }</span>
	</button>
}

templ FilterActiveEventsButton(count int) {
	<button
		class="appearance-none outline-none rounded-full cursor-pointer py-1 px-2 transition duration-300
				flex items-center gap-2 focus:ring-2 focus:ring-teal-700 focus:ring-offset-2
				focus:ring-offset-teal-50 disabled:cursor-not-allowed disabled:animate-pulse"
		data-class={ `{'bg-teal-700 text-white':$managePageFilter=='active',
						'border border-slate-300':$managePageFilter!='active'}` }
		aria-label="Filter Active Events only"
		id="btnActiveeEvents"
		style="view-transition-name:btn-active-events"
		data-on:click="$managePageNumber=1;$managePageFilter='active';@post('/manage/filter',{openWhenHidden:true})"
		data-indicator="_fetchingActiveStatusRecord"
		data-attr:disabled={ `$_fetchingActiveStatusRecord || $_fetchingInactiveStatusRecord 
					|| $_fetchingAllStatusRecord` }
	>
		<span>Active</span>
		<span
			class="py-1 px-2 text-sm rounded-full"
			data-class={ `{'bg-teal-600':$managePageFilter=='active',
							'bg-gray-200':$managePageFilter!='active'}` }
		>{ strconv.Itoa(count) }</span>
	</button>
}

templ FilterInactiveEventsButton(count int) {
	<button
		class="appearance-none outline-none rounded-full cursor-pointer py-1 px-2 transition duration-300
				flex items-center gap-2 focus:ring-2 focus:ring-teal-700 focus:ring-offset-2
				focus:ring-offset-teal-50 disabled:cursor-not-allowed disabled:animate-pulse"
		data-class={ `{'bg-teal-700 text-white':$managePageFilter=='inactive',
						'border border-slate-300':$managePageFilter!='inactive'}` }
		aria-label="Filter Inactive Events only"
		id="btnActiveEvents"
		style="view-transition-name:btn-inactive-events"
		data-on:click="$managePageNumber=1;$managePageFilter='inactive';@post('/manage/filter',{openWhenHidden:true})"
		data-indicator="_fetchingInactiveStatusRecord"
		data-attr:disabled={ `$_fetchingActiveStatusRecord || $_fetchingInactiveStatusRecord 
					|| $_fetchingAllStatusRecord` }
	>
		<span>Inactive</span>
		<span
			class="py-1 px-2 text-sm rounded-full"
			data-class={ `{'bg-teal-600':$managePageFilter=='inactive',
							'bg-gray-200':$managePageFilter!='inactive'}` }
		>{ strconv.Itoa(count) }</span>
	</button>
}
