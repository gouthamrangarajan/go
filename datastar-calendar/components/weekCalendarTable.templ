package components

import (
	"datastar-calendar/components/shared"
	"datastar-calendar/models"
	"strings"
)

var dateLayout = "2006-01-02"

templ weekCalendarTable(data models.WeekCalendarData) {
	{{ days := []string{"Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"} }}
	<table class="w-full h-full table-fixed" style="view-transition-name:none">
		<thead>
			for idx,day:= range days {
				<th class={ getThClass(idx, data.From) } style="view-transition-name:none">
					<div class="flex flex-col items-center w-full">
						<span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
							{ day }
						</span>
					</div>
				</th>
			}
		</thead>
		<tbody>
			for idx,_:= range days {
				{{ active, activeClass := getActiveFlagAndActiveClassMonthTd(data.CalendarData[0][idx], data.CurrentMonthAndYear) }}
				<td class={ getTdClass(idx, data.From) } style="view-transition-name:none">
					<div class="xl:mt-20">
						@shared.AddEventLink(data.CalendarData[0][idx], active)
					</div>
					<div
						class={ `w-full h-full  overflow-x-hidden overflow-y-auto shadow p-1 
								 scrollbar-thin scrollbar-track-orange-200 scrollbar-thumb-orange-600` }
					>
						<div
							class={ `shadow border-l-2  flex flex-col items-start gap-3 ` + activeClass }
							id={ "eventsContainer-" + data.CalendarData[0][idx].Format("2006-01-02") }
						>
							for _,event := range filterDateEvents(data.EventsData,data.CalendarData[0][idx]) {
								@shared.CalendarTableEventItem(event)
							}
						</div>
					</div>
				</td>
			}
		</tbody>
	</table>
}

func getThClass(idx int, from string) string {
	val := "animate-slide-left"
	if strings.ToLower(from) == "prev" {
		val = "animate-slide-right"
	}
	if idx != 6 {
		val += " border-r-2 border-y-2 border-gray-300"
	} else {
		val += " border-y-2 border-gray-300"
	}
	return val
}
func getTdClass(idx int, from string) string {
	val := "animate-slide-left"
	if strings.ToLower(from) == "prev" {
		val = "animate-slide-right"
	}
	if idx != 6 {
		val += " border-r-2 border-gray-300"
	}
	return val
}
