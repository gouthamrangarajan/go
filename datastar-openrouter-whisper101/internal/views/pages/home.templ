package pages


templ Home() {
	<!DOCTYPE html>
	<html lang="en" class="w-full h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>StreamScribe</title>
			<link rel="stylesheet" href="/assets/css/stream-scribe.css"/>
			<link rel="stylesheet" href="/assets/css/open-props.min.css"/>
		</head>
		<body class="w-full h-full">
			<header class="py-2 px-4 w-full">
				<div class="flex gap-3 items-center text-slate-500">
					<p class="text-3xl text-primary">StreamScribe</p>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="24"
						height="24"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="size-8"
					><path d="M12 17v4"></path><path d="M18 11a6 6 0 00-3-5.197"></path><path d="M2 11a10 10 0 015-8.662"></path><path d="M22 11a10 10 0 00-5-8.662"></path><path d="M6 11a6 6 0 013-5.197"></path><path d="M9 21h6"></path><rect x="10" y="9" width="4" height="8" rx="2"></rect></svg>
				</div>
			</header>
			<main
				class="w-full h-[85vh] flex flex-col gap-3 items-center justify-center"
				data-signals="{_recording:false}"
			>
				<form
					enctype="multipart/form-data"
					data-on:submit-form={ `
						if(!$_submitting){
							@post("/transcribe",{contentType: 'form'});
						}
					` }
					data-indicator="_submitting"
				>
					<input type="file" class="hidden" id="audio-file" name="audioFile"/>
					<button
						type="button"
						class={ `appearance-none outline-none transition duration-300 shadow rounded-full
								p-3  cursor-pointer hover:opacity-90 focus:ring-2 focus:ring-offset-2 
								disabled:cursor-not-allowed disabled:opacity-80 disabled:pointer-events-none` }
						data-class={ `{'text-white bg-blue-700 focus:ring-blue-700 focus:ring-offset-blue-50':!$_recording && !$_submitting,
									'text-red-600 bg-slate-50 focus:ring-red-600 focus:ring-offset-red-50':$_recording,
									'border border-slate-600 text-slate-600':$_submitting}` }
						data-on:click={ `if ($_recording) { stopRecording();  }
										else { setupRecorderAndStart();  }` }
						data-on:recording-started__window__viewTransition={ `$_recording=true;` }
						data-on:recording-stopped__window__viewTransition={ `$_recording=false;	
										const fileInput =document.getElementById("audio-file");
										fileInput.files = evt.detail.fileList;
										el.dispatchEvent(new CustomEvent("submit-form", { bubbles: true }));
									` }
						data-on:recording-access-error__window={ `$_recording=false;alert("Error occurred while accessing microphone. Please check your microphone settings.")` }
						style="view-transition-name: record-button"
						data-attr:disabled="$_submitting"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="size-8"
							data-show="!$_recording && !$_submitting"
							style="display:none;view-transition-name: record-icon"
						><path d="M12 19v3"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><rect x="9" y="2" width="6" height="13" rx="3"></rect>
						</svg>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							fill="currentColor"
							class="size-8"
							style="display:none;view-transition-name: record-icon"
							data-show="$_recording"
						>
							<path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd"></path>
						</svg>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" 
							stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" 
							class="size-8 animate-spinner"
							style="display:none;view-transition-name: record-icon"
							data-show="$_submitting">
							<path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m16.2 16.2 2.9 2.9"/>
							<path d="M12 18v4"/><path d="m4.9 19.1 2.9-2.9"/><path d="M2 12h4"/><path d="m4.9 4.9 2.9 2.9"/>
						</svg>
					</button>
				</form>
				<div class="p-4" id="result">
				</div>
			</main>
			<footer class="py-2 px-4 border-t-2 border-slate-300"></footer>
			// <footer>
			// 	<p>&copy; 2026 My Web Application</p>
			// </footer>
			<script type="module" src="/assets/js/data-star.min.js"></script>
			<script type="text/javascript" src="/assets/js/audio-recorder.js"></script>
		</body>
	</html>
}

