package components

import (
	"datastar-openrouter-whisper101/internal/services/openrouter"
	"fmt"
)

templ Transcribing(){
    <div class="p-4 bg-slate-100 rounded shadow relative w-11/12 md:w-9/12 lg:w-6/12 xl:w-5/12" id="result">
        <h2 class="text-lg font-semibold mb-2 animate-pulse">Transcribing...</h2>
        <p class="text-gray-700">Please wait while we process your audio file.</p>
    </div>
}
templ TranscribeResult(result *openrouter.TranscribeResponse) {
	<div class="p-4 bg-slate-100 rounded shadow relative w-11/12 md:w-9/12 lg:w-6/12 xl:w-5/12" id="result">
		<h2 class="text-lg font-semibold mb-2">Transcription Result</h2>
		<p class="text-gray-700">{result.Text}</p>
		<span class="absolute top-2 right-2 rounded-xl py-1 px-3 bg-slate-700 text-white">
			{fmt.Sprintf("%.2f", result.Usage.Seconds)} seconds
		</span>
	</div>
}
templ TranscribeError() {
    <div class="p-4 bg-red-100 rounded shadow relative w-11/12 md:w-9/12 lg:w-6/12 xl:w-5/12" id="result">
        <h2 class="text-lg font-semibold mb-2 text-red-700">Transcription Error</h2>
        <p class="text-gray-700">An error occurred while transcribing the audio. Please try again.</p>
    </div>
}