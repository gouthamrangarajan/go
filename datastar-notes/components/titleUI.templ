package components

import "datastar-notes/models"

templ NoteTitleUI(data models.NoteData, replacedId string) {
	<div
		class="border-b-2 border-gray-400 py-2 px-4 h-12 text-lg cursor-pointer flex items-center gap-1"
		id={ "titleUI_" + replacedId }
		style={ "view-transition-name:title-" + replacedId }
	>
		<span class="flex-1">{ data.Title }</span>
		<button
			class="appearance-none outline-none transition duration-300 cursor-pointer text-teal-600 p-1 rounded-full flex focus:ring-1 focus:ring-teal-600 disabled:opacity-80 disabled:cursor-not-allowed"
			title="Summarize Note Content"
			aria-label="Summarize Note Content"
			data-on-click={ "$noteId='" + data.Id + "';$showSummaryModal=true;@post('/notes/summarize')" }
			data-indicator="_summarizingNote"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M9 4.5a.75.75 0 0 1 .721.544l.813 2.846a3.75 3.75 0 0 0 2.576 2.576l2.846.813a.75.75 0 0 1 0 1.442l-2.846.813a3.75 3.75 0 0 0-2.576 2.576l-.813 2.846a.75.75 0 0 1-1.442 0l-.813-2.846a3.75 3.75 0 0 0-2.576-2.576l-2.846-.813a.75.75 0 0 1 0-1.442l2.846-.813A3.75 3.75 0 0 0 7.466 7.89l.813-2.846A.75.75 0 0 1 9 4.5ZM18 1.5a.75.75 0 0 1 .728.568l.258 1.036c.236.94.97 1.674 1.91 1.91l1.036.258a.75.75 0 0 1 0 1.456l-1.036.258c-.94.236-1.674.97-1.91 1.91l-.258 1.036a.75.75 0 0 1-1.456 0l-.258-1.036a2.625 2.625 0 0 0-1.91-1.91l-1.036-.258a.75.75 0 0 1 0-1.456l1.036-.258a2.625 2.625 0 0 0 1.91-1.91l.258-1.036A.75.75 0 0 1 18 1.5ZM16.5 15a.75.75 0 0 1 .712.513l.394 1.183c.15.447.5.799.948.948l1.183.395a.75.75 0 0 1 0 1.422l-1.183.395c-.447.15-.799.5-.948.948l-.395 1.183a.75.75 0 0 1-1.422 0l-.395-1.183a1.5 1.5 0 0 0-.948-.948l-1.183-.395a.75.75 0 0 1 0-1.422l1.183-.395c.447-.15.799-.5.948-.948l.395-1.183A.75.75 0 0 1 16.5 15Z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<button
			class="appearance-none outline-none transition duration-300 cursor-pointer text-indigo-600 p-1 rounded-full flex focus:ring-1 focus:ring-indigo-600 disabled:opacity-80 disabled:cursor-not-allowed"
			data-on-click={ "$noteId='" + data.Id + "';$noteTitle='" + data.Title + "';@get('/notes/title/edit');" }
			data-indicator={ "_fetchingEditTitleUI_" + replacedId }
			data-attr-disabled={ "$_fetchingEditTitleUI_" + replacedId }
			aria-label="Edit Note Title"
			title="Edit Note Title"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-12.15 12.15a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32L19.513 8.2Z"></path>
			</svg>
		</button>
		<button
			class="appearance-none outline-none transition duration-300 cursor-pointer text-red-600 p-1 rounded-full flex focus:ring-1 focus:ring-red-600 disabled:opacity-80 disabled:cursor-not-allowed"
			data-on-click={ "$noteId='" + data.Id + "';$showDeleteModal=true;" }
			aria-label="Delete Note"
			title="Delete Note"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
}

templ NoteTitleEditUI(data models.NoteData, replacedId string) {
	<div
		class="border-b-2 border-indigo-600 py-2 px-4 h-12 text-lg cursor-pointer flex items-center gap-2 group"
		id={ "titleUI_" + replacedId }
		style={ "view-transition-name:title-" + replacedId }
		data-on-save-title={ "$noteId='" + data.Id + "';$noteTitle=$_noteTitleInp_" + replacedId + ".value;@post('/notes/title/edit');" }
	>
		<input
			type="text"
			class="appearance-none outline-none flex-1"
			value={ data.Title }
			autofocus
			data-ref={ "_noteTitleInp_" + replacedId }
			data-on-keyup="evt.key == 'Enter' && evt.target.dispatchEvent(new CustomEvent('save-title',{bubbles:true}));"
		/>
		<button
			class="appearance-none outline-none rounded shadow p-1 bg-green-600 text-white cursor-pointer transition duration-300 focus:ring-2 focus:ring-green-600 focus:ring-offset-2 focus:ring-offset-green-50 disabled:opacity-80 disabled:cursor-not-allowed"
			aria-label="Save Note Title"
			title="Save Note Title"
			data-on-click="evt.target.dispatchEvent(new CustomEvent('save-title',{bubbles:true}));"
			data-indicator={ "_savingTitle_" + replacedId }
			data-attr-disabled={ "$_savingTitle_" + replacedId }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<button
			class="appearance-none outline-none  rounded shadow p-1 bg-red-600 text-white cursor-pointer transition duration-300 focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50 disabled:opacity-80 disabled:cursor-not-allowed"
			aria-label="Cancel Title Edit Changes"
			title="Cancel Title Edit Changes"
			data-on-click={ "$noteId='" + data.Id + "';$noteTitle='" + data.Title + "';@post('/notes/title/edit');" }
			data-indicator={ "_savingTitle_" + replacedId }
			data-attr-disabled={ "$_savingTitle_" + replacedId }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
}
