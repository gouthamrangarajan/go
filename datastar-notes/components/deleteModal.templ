package components

templ deleteModal() {
	<div
		class="absolute top-0 left-0 bg-black/50 w-full h-full flex items-center justify-center z-10"
		data-show="$showDeleteModal"
		data-signals="{_modalAbortController:new AbortController()}"
		data-effect="$showDeleteModal?$_modalAbortController=focusTrap('#deleteModal'):$_modalAbortController.abort()"
		style="display:none;"
	>
		<dialog
			open
			class="w-11/12 mx-auto animate-modal bg-white py-4 px-6 rounded flex flex-col md:w-7/12 lg:w-5/12"
			id="deleteModal"
			style="view-transition-name:delete-dialog"
		>
			<h1 class="text-lg font-semibold text-red-600">Confirm Note Deletion</h1>
			<p id="deleteError" class="mt-4"></p>
			<div class="mt-4 flex flex-col">
				<p>This action will permanently delete your note and cannot be recovered. Are you sure you want to proceed?</p>
				<div class="flex items-center justify-end gap-2 w-full mt-5">
					<button
						class="appearance-none outline-none cursor-pointer shrink-0  py-2 px-4 rounded transition duration-300 hover:opacity-80 focus:ring-2 focus:ring-red-600 focus:ring-offset-2 focus:ring-offset-red-50  disabled:cursor-not-allowed disabled:opacity-80"
						data-on-click="@post('/notes/delete')"
						data-indicator="_deleting"
						data-attr-disabled="$_deleting"
						data-class="{'bg-red-600 text-white':!$_deleting,'bg-white text-red-600 ring-2 ring-red-500':$_deleting}"
					>
						<span>Yes, Delete</span>
					</button>
					<button
						class="appearance-none outline-none cursor-pointer py-2 px-4 rounded bg-slate-200 transition duration-300 hover:bg-slate-300 focus:ring-1 focus:ring-slate-600 focus:ring-offset-2 focus:ring-offset-slate-50 disabled:cursor-not-allowed disabled:opacity-80"
						data-attr-disabled="$_deleting"
						data-on-click__viewTransition="$showDeleteModal=false;"
					>Cancel</button>
				</div>
			</div>
		</dialog>
	</div>
}

templ DeleteErrorMessage(message string) {
	<p id="deleteError" data-show="!$deleting" class="w-full animate-result bg-red-200 text-red-600 rounded py-1 px-3 mt-4 font-semibold">
		{ message }
	</p>
}
