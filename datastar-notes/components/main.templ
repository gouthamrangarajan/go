package components

import "datastar-notes/models"

templ Main(data []models.NoteData) {
	@layout() {
		@MainEl(data)
	}
}

templ MainEl(data []models.NoteData) {
	<main
		class="relative w-full h-full flex flex-col gap-2"
		id="main"
		data-signals="{showDeleteModal:false,showSummaryModal:false}"
	>
		@header()
		@Section(data)
		@summarizeNotesModal()
		@deleteModal()
		@loader("$_deleting || $_fetchingReorderUI || $_fetchingEditorUI || $_savingReorder || $_summarizingNote")
	</main>
}

templ Section(data []models.NoteData) {
	<section
		class="w-full h-full py-2 px-4 pb-4 flex flex-col gap-2 overflow-y-auto scroll-smooth scrollbar-thin scrollbar-track-gray-200 scrollbar-thumb-indigo-600 lg:flex-row lg:overflow-x-auto lg:overflow-y-hidden"
		id="section"
		style="view-transition-name:section"
	>
		@EditorList(data)
	</section>
}

templ SectionForReorder(data []models.NoteData) {
	<section
		class="py-2 px-4 pb-4 justify-start items-start flex flex-col gap-2 flex-wrap overflow-y-auto scroll-smooth scrollbar-thin scrollbar-track-gray-200 scrollbar-thumb-indigo-600 lg:flex-row lg:overflow-x-auto lg:overflow-y-hidden"
		id="section"
		style="view-transition-name:section"
		data-on-reordered="$orderInfo=evt.detail;@post('/notes/reorder')"
		data-indicator="_savingReorder"
	>
		for _,item := range data {
			{{ replacedId := ReplaceHypenInId(item.Id) }}
			<div
				class="py-2 px-4 shadow bg-white shrink-0 rounded cursor-pointer font-semibold"
				style={ "view-transition-name:editor-container-" + replacedId }
				data-id={ item.Id }
			>
				{ item.Title }
			</div>
		}
	</section>
}

templ header() {
	<header class="shadow py-2 px-4 flex items-center justify-between gap-2" style="view-transition-name:header">
		<div class="flex items-center gap-2 text-xl ">
			<span class="tracking-widest font-[Meow_Script,cursive] font-bold text-4xl text-indigo-600">RG</span>
			<span>Notes</span>
		</div>
		<div class="flex items-center gap-3" id="headerActionsContainer">
			@AddButton()
			@ReorderButton()
		</div>
	</header>
}

templ AddButton() {
	<button
		class="appearance-none outline-none flex gap-2 items-center rounded shadow py-1 px-3 bg-indigo-600 text-white cursor-pointer transition duration-300 focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 focus:ring-offset-indigo-50 disabled:opacity-80 disabled:cursor-not-allowed"
		data-on-click="@post('/notes/add')"
		data-indicator="_creatingNote"
		data-attr-disabled="$_creatingNote"
		id="addBtn"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
			<path fill-rule="evenodd" d="M12 3.75a.75.75 0 0 1 .75.75v6.75h6.75a.75.75 0 0 1 0 1.5h-6.75v6.75a.75.75 0 0 1-1.5 0v-6.75H4.5a.75.75 0 0 1 0-1.5h6.75V4.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd"></path>
		</svg>
		<span>Add</span>
	</button>
}

templ ReorderButton() {
	<button
		id="toggleEditorUIOrReorderButton"
		data-on-click="!$_fetchingReorderUI && @get('/notes/reorder')"
		data-indicator="_fetchingReorderUI"
		class="appearance-none outline-none cursor-pointer text-teal-600 p-1 rounded-full transition duration-300 focus:ring-1 focus:ring-teal-600 disabled:cursor-not-allowed disabled:opacity-80"
		style="view-transition-name:toggle-button"
		aria-label="Reorder Notes"
		title="Reorder Notes"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
			<path fill-rule="evenodd" d="M12 5.25c1.213 0 2.415.046 3.605.135a3.256 3.256 0 0 1 3.01 3.01c.044.583.077 1.17.1 1.759L17.03 8.47a.75.75 0 1 0-1.06 1.06l3 3a.75.75 0 0 0 1.06 0l3-3a.75.75 0 0 0-1.06-1.06l-1.752 1.751c-.023-.65-.06-1.296-.108-1.939a4.756 4.756 0 0 0-4.392-4.392 49.422 49.422 0 0 0-7.436 0A4.756 4.756 0 0 0 3.89 8.282c-.017.224-.033.447-.046.672a.75.75 0 1 0 1.497.092c.013-.217.028-.434.044-.651a3.256 3.256 0 0 1 3.01-3.01c1.19-.09 2.392-.135 3.605-.135Zm-6.97 6.22a.75.75 0 0 0-1.06 0l-3 3a.75.75 0 1 0 1.06 1.06l1.752-1.751c.023.65.06 1.296.108 1.939a4.756 4.756 0 0 0 4.392 4.392 49.413 49.413 0 0 0 7.436 0 4.756 4.756 0 0 0 4.392-4.392c.017-.223.032-.447.046-.672a.75.75 0 0 0-1.497-.092c-.013.217-.028.434-.044.651a3.256 3.256 0 0 1-3.01 3.01 47.953 47.953 0 0 1-7.21 0 3.256 3.256 0 0 1-3.01-3.01 47.759 47.759 0 0 1-.1-1.759L6.97 15.53a.75.75 0 0 0 1.06-1.06l-3-3Z" clip-rule="evenodd"></path>
		</svg>
	</button>
}

templ ViewEditorsUIButton() {
	<button
		id="toggleEditorUIOrReorderButton"
		data-on-click="!$_fetchingEditorUI && @get('/notes/editorui')"
		data-indicator="_fetchingEditorUI"
		class="appearance-none outline-none cursor-pointer text-teal-600 p-1 rounded-full transition duration-300 focus:ring-1 focus:ring-teal-600 disabled:cursor-not-allowed disabled:opacity-80"
		style="view-transition-name:toggle-button"
		aria-label="View Notes"
		title="View Notes"
	>
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
			<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path>
			<path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd"></path>
		</svg>
	</button>
}
