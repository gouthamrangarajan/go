package components

import (
	"datastar-web-learnings/models"
	"strings"
)

templ PlayerList(videos []models.VideoResponse, searchQuery string) {
	for idx,video := range videos {
		@Player(video, idx, searchQuery)
	}
}

templ Player(video models.VideoResponse, idx int, searchQuery string) {
	{{ animationDelayStyle := "" }}
	{{ videoIdReplaced := replaceSpecialCharsVideoId(video.VideoId) }}
	{{ containerId := "playerContainer_" + video.VideoId + "_" + strings.ReplaceAll(searchQuery, " ", "_") }}
	{{
		switch idx {
		case 0:
			animationDelayStyle = "0"
		case 1:
			animationDelayStyle = "100ms"
		case 2:
			animationDelayStyle = "200ms"
		case 3:
			animationDelayStyle = "300ms"
		case 4:
			animationDelayStyle = "400ms"
		case 5:
			animationDelayStyle = "500ms"
		case 6:
			animationDelayStyle = "600ms"
		case 7:
			animationDelayStyle = "700ms"
		case 8:
			animationDelayStyle = "800ms"
		case 9:
			animationDelayStyle = "900ms"
		default:
			animationDelayStyle = "1000ms"
		}
	}}
	<div
		id={ containerId }
		class={ " shadow bg-secondary/20 rounded-xl grid grid-cols-1 gap-1 overflow-hidden relative h-88 lg:h-86" }
		style={ " opacity:0;animation-delay: " + animationDelayStyle + ";view-transition-name:video_" + videoIdReplaced }
		data-signals={ "{_video_" + videoIdReplaced + ":null,_video_" + videoIdReplaced + "_showTags:false}" }
		data-init={ `initYTPlayer('` + video.VideoId + `',0).then(player=>{$_video_` + videoIdReplaced + `=player;});` }
		data-effect={ `$_activeInlinePlayerVideoId && '` + videoIdReplaced + `'!=$_activeInlinePlayerVideoId.replaceAll('-','') 
						&& $_video_` + videoIdReplaced + `.getPlayerState && $_video_` + videoIdReplaced + `.getPlayerState()==1 
						? $_video_` + videoIdReplaced + `.pauseVideo() : null` }
		data-on-intersect__exit={ `$_video_` + videoIdReplaced + `.getPlayerState && $_video_` + videoIdReplaced + `.getPlayerState()==1 
									? 
									setTimeout(()=>{
										$_dockedPlayerDurationToStart=$_video_` + videoIdReplaced + `.getCurrentTime();
										$_video_` + videoIdReplaced + `.pauseVideo();										
										$_dockedPlayerVideoId='` + video.VideoId + `';										
									},1)
									: null` }
	>
		<div
			class="h-64"
			id={ "player_" + video.VideoId }
			data-show={ "!$_video_" + videoIdReplaced + "_showTags" }
			data-effect={ `$_isDockedPlayerActive && $_video_` + videoIdReplaced + `.getPlayerState 
							&& $_video_` + videoIdReplaced + `.getPlayerState()==1 
							? $_video_` + videoIdReplaced + `.pauseVideo() : null` }
		></div>
		<div class="py-1 px-3 flex gap-1 items-center">
			<div class="flex flex-col flex-1 gap-1">
				<h3 class="text-lg  font-semibold">{ video.Title }</h3>
				<h4 class="text-secondary italic text-sm">{ video.Subtitle }</h4>
			</div>
			<button
				class="appearance-none outline-none cursor-pointer p-1 rounded-full text-primary transition duration-300 focus:ring-1 focus:ring-primary hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 disabled:pointer-events-none"
				data-show={ "!$_video_" + videoIdReplaced + "_showTags" }
				aria-label="Open Quiz"
				data-on:click={ `$quizVideoId='` + video.VideoId + `';$quizVideoTitle='` + video.Title + `';$_loadingQuiz=true;@get('/quiz')` }
				data-attr:disabled="$_loadingQuiz"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-5"
				>
					<path d="M13.4 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7.4"></path>
					<path d="M2 6h4"></path><path d="M2 10h4"></path><path d="M2 14h4"></path><path d="M2 18h4"></path>
					<path d="M21.378 5.626a1 1 0 1 0-3.004-3.004l-5.01 5.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"></path>
				</svg>
			</button>
			<button
				class="appearance-none outline-none cursor-pointer p-1 rounded-full text-secondary transition duration-300 focus:ring-1 focus:ring-secondary hover:opacity-90"
				data-show={ "!$_video_" + videoIdReplaced + "_showTags" }
				data-on:click={ "initYTPlayer('" + video.VideoId + "',0).then(player=>{$_video_" + videoIdReplaced + "=player;});" }
				aria-label="Reload Video"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
					<path fill-rule="evenodd" d="M4.755 10.059a7.5 7.5 0 0 1 12.548-3.364l1.903 1.903h-3.183a.75.75 0 1 0 0 1.5h4.992a.75.75 0 0 0 .75-.75V4.356a.75.75 0 0 0-1.5 0v3.18l-1.9-1.9A9 9 0 0 0 3.306 9.67a.75.75 0 1 0 1.45.388Zm15.408 3.352a.75.75 0 0 0-.919.53 7.5 7.5 0 0 1-12.548 3.364l-1.902-1.903h3.183a.75.75 0 0 0 0-1.5H2.984a.75.75 0 0 0-.75.75v4.992a.75.75 0 0 0 1.5 0v-3.18l1.9 1.9a9 9 0 0 0 15.059-4.035.75.75 0 0 0-.53-.918Z" clip-rule="evenodd"></path>
				</svg>
			</button>
			<button
				class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
				data-on:click__viewTransition={ `$videoToDelete='` + video.VideoId + `';$showDeleteConfirm=true;` }
				data-show={ "!$_video_" + videoIdReplaced + "_showTags && !$_showLoginButton" }
				style="display:none;"
				aria-label="Delete Video"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
					<path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd"></path>
				</svg>
			</button>
			<button
				class="appearance-none outline-none cursor-pointer p-1 rounded-full text-primary transition duration-300 focus:ring-1 focus:ring-primary hover:opacity-90"
				data-on:click={ "$_video_" + videoIdReplaced + "_showTags=true;" }
				data-show={ "!$_video_" + videoIdReplaced + "_showTags" }
				aria-label="Show Tags"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
					<path fill-rule="evenodd" d="M10.5 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" clip-rule="evenodd"></path>
				</svg>
			</button>
		</div>
		@Tags(videoIdReplaced, video.Tags)
	</div>
}

templ Tags(videoIdReplaced string, tags []string) {
	<div
		class="py-1 px-3 absolute top-0 left-0 w-full h-full overflow-hidden bg-background-2 transition duration-300 transform opacity-0 ease-(--ease-3) flex gap-1 items-start"
		data-class={ "{'opacity-0 translate-y-[100%]':!$_video_" + videoIdReplaced + "_showTags,'z-10 opacity-100 translate-y-0':$_video_" + videoIdReplaced + "_showTags}" }
	>
		<div class="flex gap-2 flex-wrap items-center justify-start flex-1">
			for _,tag := range tags {
				<span class="py-1 px-3 bg-background text-sm text-primary rounded-xl">{ tag }</span>
			}
		</div>
		<button
			class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
			data-on:click={ "$_video_" + videoIdReplaced + "_showTags=false;" }
			data-show={ "$_video_" + videoIdReplaced + "_showTags" }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
}

templ dockedPlayer() {
	<div
		class="animate-docked-player h-[30vh] w-11/12 fixed bottom-0 left-0.5 md:left-1.5 md:w-9/12 lg:h-[50vh] lg:left-3 lg:w-6/12  xl:left-3.5 xl:w-5/12"
		style="display:none;"
		data-show="$_dockedPlayerVideoId"
		data-effect={ `$_dockedPlayerVideoId ? 																		
						setTimeout(()=>{
							$_dockedPlayer=initDockedYTPlayer($_dockedPlayerVideoId,$_dockedPlayer,$_dockedPlayerDurationToStart);
						},1)
						:null` }
	>
		<button
			class="appearance-none outline-none absolute top-2 right-2 cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
			aria-label="close player"
			data-on:click__viewTransition={ `$_dockedPlayer.pauseVideo();$_dockedPlayerVideoId='';` }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
		<div
			class="w-full h-full"
			id="docker_player"
			data-effect={ ` $_activeInlinePlayerVideoId && $_dockedPlayer && $_dockedPlayer.getPlayerState && $_dockedPlayer.getPlayerState()==1 
								 ? 
							$_dockedPlayer.pauseVideo() : null` }
		></div>
	</div>
}
