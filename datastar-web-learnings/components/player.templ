package components

import "datastar-web-learnings/models"

templ PlayerList(videos []models.VideoResponse) {
	for idx,video := range videos {
		@Player(video, idx)
	}
}

templ Player(video models.VideoResponse, idx int) {
	{{ animationDelayStyle := "" }}
	{{ videoIdReplaced := replaceSpecialCharsVideoId(video.VideoId) }}
	{{
	switch idx {
	case 0:
		animationDelayStyle = "0"
	case 1:
		animationDelayStyle = "100ms"
	case 2:
		animationDelayStyle = "200ms"
	case 3:
		animationDelayStyle = "300ms"
	case 4:
		animationDelayStyle = "400ms"
	case 5:
		animationDelayStyle = "500ms"
	case 6:
		animationDelayStyle = "600ms"
	case 7:
		animationDelayStyle = "700ms"
	case 8:
		animationDelayStyle = "800ms"
	case 9:
		animationDelayStyle = "900ms"
	default:
		animationDelayStyle = "1000ms"
	}
	}}
	<div
		class={ " animate-card shadow bg-secondary/20 rounded-xl grid grid-cols-1 gap-1 overflow-hidden relative" }
		style={ " opacity:0;animation-delay: " + animationDelayStyle }
		data-signals={ "{_video_" + videoIdReplaced + ":null,_video_" + videoIdReplaced + "_showTags:false}" }
		data-on-load={ "initYTPlayer('" + video.VideoId + "',0).then(player=>{$_video_" + videoIdReplaced + "=player;});" }
		data-effect={ "'" + videoIdReplaced + "'!=$currentlyPlayingVideoId.replaceAll('-','') && $currentlyPlayingVideoId && $_video_" + videoIdReplaced + ".getPlayerState && $_video_" + videoIdReplaced + ".getPlayerState()==1 && $_video_" + videoIdReplaced + ".pauseVideo()" }
	>
		<div
			class="h-64"
			id={ "player_" + video.VideoId }
		></div>
		<div class="py-1 px-3 flex gap-1 items-center">
			<div class="flex flex-col flex-1 gap-1">
				<h3 class="text-lg  font-semibold">{ video.Title }</h3>
				<h4 class="text-secondary italic text-sm">{ video.Subtitle }</h4>
			</div>
			<button
				class="appearance-none outline-none cursor-pointer p-1 rounded-full text-secondary transition duration-300 focus:ring-1 focus:ring-secondary hover:opacity-90"
				data-on-click={ "$_video_" + videoIdReplaced + "_showTags=true;" }
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
					<path fill-rule="evenodd" d="M10.5 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Zm0 6a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" clip-rule="evenodd"></path>
				</svg>
			</button>
		</div>
		@Tags(videoIdReplaced, video.Tags)
	</div>
}

templ Tags(videoIdReplaced string, tags []string) {
	<div
		class="py-1 px-3 absolute top-0 left-0 w-full h-full overflow-hidden z-10 bg-background-2 transition duration-300 transform opacity-0 ease-(--ease-3) flex gap-1 items-start"
		data-class={ "{'opacity-0 translate-y-[100%]':!$_video_" + videoIdReplaced + "_showTags,'opacity-100 translate-y-0':$_video_" + videoIdReplaced + "_showTags}" }
	>
		<div class="flex gap-2 flex-wrap items-center justify-start flex-1">
			for _,tag := range tags {
				<span class="py-1 px-3 bg-background text-sm text-primary rounded-xl">{ tag }</span>
			}
		</div>
		<button
			class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
			data-on-click={ "$_video_" + videoIdReplaced + "_showTags=false;" }
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
}
