package components

import (
	"datastar-web-learnings/models"
	"strconv"
)

templ quiz() {
	<div
		class="absolute  top-0 left-0 bg-secondary/20 w-full h-full grid place-items-center"
		data-show="$_showQuiz"
		data-signals="{_abortControllerForQuiz:new AbortController()}"
		data-effect="{$_showQuiz?$_abortControllerForQuiz=focusTrap('#quizDialog'):setTimeout(()=>{$transcript='';$_abortControllerForQuiz.abort();},1)}"
		style="display:none;"
	>
		<dialog
			open
			class={ ` animate-modal rounded-xl text-primary bg-background-2 py-4 px-6 mx-auto w-[90vw] max-w-[1100px] max-h-[85vh]
					 overflow-y-auto overflow-x-hidden scroll-smooth scrollbar-thin scrollbar-thumb-secondary scrollbar-track-background-2` }
			id="quizDialog"
			style="view-transition-name:quiz-modal"
		>
			<div class="w-full flex items-center justify-center mt-4  h-[30vh]">
				<span class="w-8 h-8 rounded-full border-dashed border-2 border-secondary animate-spin"></span>
			</div>
		</dialog>
	</div>
}

templ CreateQuizForm(transcript string) {
	<div class="flex items-center justify-between">
		<h2 class="text-xl text-secondary font-semibold">Create a quiz</h2>
		<button
			class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
			aria-label="close quiz"
			data-on:click__viewTransition="$_showQuiz = false"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
	<span class="mt-4" data-text="$quizVideoTitle"></span>
	<form
		class="mt-3 flex flex-col gap-3 w-full animate-fade"
		data-on:submit__prevent={ `if(!$_submitting){@post('/quiz');}` }
		data-indicator="_submitting"
		id="quizForm"
	>
		<div class="flex flex-col gap-1">
			<span>1. Open the video and copy its transcript </span>
			<a
				target="_blank"
				data-attr:href={ `'https://www.youtube.com/watch?v='+$quizVideoId` }
				class={ `appearance-none outline-none cursor-pointer underline underline-offset-4 transition duration-300 p-1
					flex gap-1 items-end rounded focus:opacity-90 hover:opacity-90 focus:ring-1 focus:ring-primary focus:no-underline` }
			>
				<span>Open video on YouTube</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="size-5"
				>
					<path d="M13 5H19V11"></path><path d="M19 5L5 19"></path>
				</svg>
			</a>
		</div>
		<label
			for="transcript"
			class=" flex flex-col gap-1"
			id="lblTranscript"
			data-signals={ `{transcript:'` + transcript + `'}` }
		>
			<span>2. Paste the transcript</span>
			<span class="ml-1">Keep timestamps so answers can link to the video.</span>
			<textarea
				type="text"
				id="transcript"
				name="transcript"
				data-bind="transcript"
				required
				minlength="500"
				spellcheck="false"
				class="appearance-none outline-none ml-1 rounded transion duration-300 h-[30vh] w-full py-2 px-4 resize-none overflow-y-auto scroll-smooth scrollbar-thin scrollbar-track-transparent scrollbar-thumb-secondary border border-secondary focus:ring-secondary focus:ring-2  focus:ring-offset-2 focus:ring-offset-background-2"
			></textarea>
			<span class="text-xs italics"><span data-text="$transcript.length"></span> characters</span>
		</label>
		<div class="flex items-center justify-end gap-2 mt-4 w-full">
			<button
				type="button"
				class="appearance-none outline-none cursor-pointer py-2 px-4 rounded transition duration-300 focus:ring-1 focus:ring-primary hover:opacity-90"
				data-on:click__prevent="$_showQuiz=false"
			>
				Cancel
			</button>
			<button
				type="submit"
				class=" appearance-none outline-none cursor-pointer text-slate-700  py-2 px-4 rounded bg-teal-300 transition duration-300 focus:ring-2 focus:ring-teal-300 focus:ring-offset-2 focus:ring-offset-background-2 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 disabled:pointer-events-none"
				data-attr:disabled="$_submitting"
			>
				Generate quiz
			</button>
		</div>
	</form>
}

templ QuizGenerating() {
	<div class="flex items-center justify-between">
		<h2 class="text-xl text-secondary font-semibold">Creating your quiz...</h2>
		<button
			class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
			aria-label="close quiz"
			data-on:click__viewTransition="$_showQuiz = false"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
	<div
		class="mt-4 flex flex-col gap-3 w-full"
	>
		<p>Analyzing the transcript and generating <br/> questions grounded in the video.</p>
		<span>This usually takes 10-30 seconds.</span>
	</div>
	<div class="w-full flex items-center justify-center mt-4">
		<span class="w-8 h-8 rounded-full border-dashed border-2 border-secondary animate-spin"></span>
	</div>
}

templ QuizQuestion(data models.QuizResponse, index int) {
	<div class="flex items-center justify-between">
		<h2 class="text-xl text-secondary font-semibold">Question { strconv.Itoa(index + 1) } of { strconv.Itoa(len(data.Questions)) }</h2>
		<button
			class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
			aria-label="close quiz"
			data-on:click__viewTransition="$_showQuiz = false"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
	<form
		class="mt-4 flex flex-col gap-3 w-full animate-quiz"
		data-on:submit__prevent={ `if(!$_submitting){@post('/quiz');}` }
		data-indicator="_submitting"
		id="quizForm"
		data-signals={ `{_showAnswer:false,quizIndex:` + strconv.Itoa(index) + `}` }
	>
		<span class="w-full">{ data.Questions[index].Question }</span>
		<span class="text-xs text-secondary">Think or answer aloud</span>
		<a
			href="#"
			data-show="!$_showAnswer"
			data-on:click__prevent={ `$_showAnswer=true` }
			class={ `appearance-none outline-none cursor-pointer underline underline-offset-4 transition duration-300 p-1
				rounded focus:opacity-90 hover:opacity-90 focus:ring-1 focus:ring-primary focus:no-underline` }
		>
			Show answer
		</a>
		<div data-show="$_showAnswer" class="flex flex-col gap-3 w-full animate-result">
			<span>Suggested Answer:</span>
			<span class="w-full">{ data.Questions[index].ShortAnswer }</span>
		</div>
		<div class="flex items-center justify-end w-full gap-2">
			if index !=0 {
				<div class="flex-1 flex items-start">
					<button
						type="submit"
						class=" appearance-none outline-none cursor-pointer text-slate-700  py-2 px-4 rounded bg-teal-300 transition duration-300 focus:ring-2 focus:ring-teal-300 focus:ring-offset-2 focus:ring-offset-background-2 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 disabled:pointer-events-none"
						data-attr:disabled="$_submitting"
						data-on:click={ `$quizIndex--` }
					>
						Prev Question
					</button>
				</div>
			}
			if index + 1 == len(data.Questions) {
				<button
					type="submit"
					class="appearance-none outline-none cursor-pointer text-slate-700  py-2 px-4 rounded bg-teal-300 transition duration-300 focus:ring-2 focus:ring-teal-300 focus:ring-offset-2 focus:ring-offset-background-2 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 disabled:pointer-events-none"
					data-on:click={ `$quizIndex=0;$_showQuiz = false;` }
				>
					Finish Quiz
				</button>
			} else {
				<button
					type="submit"
					class=" appearance-none outline-none cursor-pointer text-slate-700  py-2 px-4 rounded bg-teal-300 transition duration-300 focus:ring-2 focus:ring-teal-300 focus:ring-offset-2 focus:ring-offset-background-2 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 disabled:pointer-events-none"
					data-attr:disabled="$_submitting"
					data-on:click={ `$quizIndex++` }
				>
					Next Question
				</button>
			}
		</div>
	</form>
}

templ QuizGenerationError() {
	<div class="flex items-center justify-between">
		<h2 class="text-xl text-red-300 font-semibold">We couldn't create the quiz.</h2>
		<button
			class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
			aria-label="close quiz"
			data-on:click__viewTransition="$_showQuiz = false"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
				<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
			</svg>
		</button>
	</div>
	<div
		class="mt-4 flex flex-col gap-3 w-full"
	>
		<p>Your transcript has been preserved. Please try again later</p>
	</div>
}
