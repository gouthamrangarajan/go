package components

templ login() {
	<div
		class="absolute  top-0 left-0 bg-secondary/20 w-full h-full grid place-items-center"
		data-show="$_showLogin"
		data-signals="{_abortController:new AbortController()}"
		data-effect="{$_showLogin?$_abortController=focusTrap('#loginDialog'):$_abortController.abort()}"
		style="display:none;"
	>
		<dialog
			open
			class="rounded-xl text-primary bg-background-2 py-4 px-6 flex flex-col mx-auto w-11/12 md:w-8/12 lg:w-5/12 xl:w-4/12"
			id="loginDialog"
			style="view-transition-name:login-modal"
		>
			<div class="flex items-center justify-between">
				<h2 class="text-xl text-secondary font-semibold underline underline-offset-5">Login</h2>
				<button
					class="appearance-none outline-none cursor-pointer p-1 rounded-full text-red-300 transition duration-300 focus:ring-1 focus:ring-red-300 hover:opacity-90"
					aria-label="close login"
					data-on-click__viewTransition="$_showLogin = false"
				>
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
						<path fill-rule="evenodd" d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path>
					</svg>
				</button>
			</div>
			<form
				class="mt-4 flex flex-col gap-3 w-full"
				data-signals="{_loginError:false,_loggingIn:false}"
				data-on-success__viewTransition="$_showLogin=false;"
				data-on-submit={ `evt.preventDefault();
                                const targetEl=evt.currentTarget;
                                $_loginError=false;
                                $_loggingIn=true;
                                 LOGIN(AUTH,
                                    new FormData(evt.currentTarget).get('username').trim(),
                                    new FormData(evt.currentTarget).get('password'))
                                .then(result=>{     
                                    $_loggingIn=false;                               
                                    if(result && result.user && result.user!=null){
                                       targetEl.dispatchEvent(new CustomEvent('success'));
                                    }
                                    }).catch(err=>{$_loginError=true;$_loggingIn=false;});` }
			>
				<p data-show="$_loginError" class="text-red-300 animate-result">
					Login failed. Please check your username and password.
				</p>
				<label for="username" class=" flex flex-col gap-1">
					Username
					<input
						type="text"
						id="username"
						name="username"
						class="appearance-none outline-none py-2 px-4 transition duration-300 rounded border focus:ring-2  focus:ring-offset-2 focus:ring-offset-background-2"
						data-class="{'border-red-300 focus:ring-red-300':$_loginError, 'border-secondary focus:ring-secondary':!$_loginError}"
						required
					/>
				</label>
				<label for="password" class="flex flex-col gap-1">
					Password
					<input
						type="password"
						id="password"
						name="password"
						class="appearance-none outline-none py-2 px-4 transition duration-300 rounded border focus:ring-2  focus:ring-offset-2 focus:ring-offset-background-2"
						data-class="{'border-red-300 focus:ring-red-300':$_loginError, 'border-secondary focus:ring-secondary':!$_loginError}"
						required
					/>
				</label>
				<button
					type="submit"
					class=" appearance-none outline-none cursor-pointer text-slate-700 w-full py-2 px-4 rounded bg-teal-300 transition duration-300 focus:ring-2 focus:ring-teal-300 focus:ring-offset-2 focus:ring-offset-background-2 hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50"
					data-attr-diabled="$_loggingIn"
				>
					Submit
				</button>
			</form>
		</dialog>
	</div>
}
